# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly declare text files
*.cls text eol=lf
*.trigger text eol=lf
*.cmp text eol=lf
*.component text eol=lf
*.page text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.apex text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text eol=lf
