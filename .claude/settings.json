{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/setup-sf-auth.sh",
                        "statusMessage": "Authenticating Salesforce CLI..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; npx prettier --write \"$f\" --ignore-unknown; } 2>/dev/null || true",
                        "statusMessage": "Running prettier..."
                    }
                ]
            }
        ]
    }
}
