{
    "name": "Alex",
    "private": true,
    "version": "1.0.0",
    "description": "A LWC Kanban Board for realtime collaboration.",
    "author": "Open Systems Foundation",
    "repository": {
        "type": "git",
        "url": "https://github.com/OpenSystemsFoundation/alex-app"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint **/{aura,lwc}/**/*.js",
        "test": "npm run test:unit",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:debug": "sfdx-lwc-jest --debug",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "postinstall": "husky install",
        "precommit": "lint-staged",
        "validate": "npm run lint && npm run prettier:verify && npm run test:unit",
        "check:security": "sf scanner run --target src --format table",
        "check:dependencies": "npm audit --audit-level=moderate"
    },
    "devDependencies": {
        "@prettier/plugin-xml": "^3.4.2",
        "prettier": "^3.6.2",
        "prettier-plugin-apex": "2.2.6"
    },
    "lint-staged": {
        "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
            "prettier --write"
        ],
        "**/{aura,lwc}/**/*.js": [
            "eslint"
        ]
    }
}
