<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Roadmap Board</masterLabel>
    <description>Agile roadmap board with Now/Next/Future and Quarterly views for epic planning</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Board__c</object>
            </objects>
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
                name="recordId"
                type="String"
                label="Board ID"
                description="The ID of the Board record to display."
                required="false"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
