<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Template flow: Auto-creates a Kanban card when a new Case is created and links them with bidirectional status sync. Configure the Board ID variable before activating.</description>
    <environments>Default</environments>
    <interviewLabel>Auto Create Card from Case {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>Auto Create Card from Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Board_Configured</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <description>The Board ID to create cards on. Set this before activating the flow.</description>
        <name>TargetBoardId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>JSON status mapping between Card and Case statuses. Default maps common statuses.</description>
        <name>StatusMappingJson</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>{"Backlog":"New","To Do":"New","In Progress":"Working","Testing":"Working","Review":"Working","Done":"Closed","Release":"Closed"}</stringValue>
        </value>
    </variables>
    <variables>
        <name>NewCardId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <decisions>
        <name>Check_Board_Configured</name>
        <label>Check Board Configured</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Board Not Configured</defaultConnectorLabel>
        <rules>
            <name>Board_Is_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TargetBoardId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TargetBoardId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Kanban_Card</targetReference>
            </connector>
            <label>Board Is Set</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Kanban_Card</name>
        <label>Create Kanban Card</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Linked_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>Board__c</field>
            <value>
                <elementReference>TargetBoardId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject__c</field>
            <value>
                <elementReference>CardSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <elementReference>$Record.Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CardType__c</field>
            <value>
                <stringValue>Bug</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority__c</field>
            <value>
                <elementReference>MappedPriority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Backlog</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SequenceNumber__c</field>
            <value>
                <numberValue>1</numberValue>
            </value>
        </inputAssignments>
        <object>Card__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Linked_Record</name>
        <label>Create Linked Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Card__c</field>
            <value>
                <elementReference>Create_Kanban_Card</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordName__c</field>
            <value>
                <elementReference>$Record.Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SObjectType__c</field>
            <value>
                <stringValue>Case</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SyncEnabled__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StatusMapping__c</field>
            <value>
                <elementReference>StatusMappingJson</elementReference>
            </value>
        </inputAssignments>
        <object>LinkedRecord__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <formulas>
        <name>CardSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.CaseNumber} &amp; " - " &amp; {!$Record.Subject}</expression>
    </formulas>
    <formulas>
        <name>MappedPriority</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Priority},
    "High", "High",
    "Critical", "High",
    "Medium", "Medium",
    "Low", "Low",
    "Medium"
)</expression>
    </formulas>
</Flow>
